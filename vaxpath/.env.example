# PostgreSQL — in production this MUST be hosted in an EU region (e.g. AWS eu-west-1 Dublin).
DATABASE_URL="postgresql://vaxpath:vaxpath@localhost:5432/vaxpath"
# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# 32-byte key, base64, for field-level encryption (AES-256-GCM): `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY="change-me"
# Declared data region; the app refuses to start outside the EU/EEA.
DATA_REGION="eu-west-1"
# Stripe TEST keys only (sk_test_...). Live keys are rejected.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
TEST_DATABASE_URL="postgresql://vaxpath:vaxpath@localhost:5432/vaxpath_test"
